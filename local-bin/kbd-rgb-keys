#!/usr/bin/env python3
"""Fn+F11 / Fn+F12 on the Acer PH16-71 keyboard -> RGB brightness down / up.

The keyboard sends these as vendor reports on its raw USB HID interface, not as key presses, so Hyprland never sees them:
    04 7c ff   Fn+F11 (press)        04 7d ff   Fn+F12 (press)        04 00 00   release
This listener reads the keyboard's hidraw nodes (needs system/etc/udev/rules.d/99-rgbkb-hidraw.rules so the logged-in user may read them)
and calls kbd-rgb-brightness. Runs as the user systemd service kbd-rgb-keys.service.
"""
import glob, os, select, subprocess, sys, time

VID_PID = "04F2:0117"            # Chicony "ACER USB-HID Gaming Keyboard"
BRIGHTNESS = os.path.expanduser("~/.local/bin/kbd-rgb-brightness")
ACTIONS = {(0x7C, 0xFF): "down", (0x7D, 0xFF): "up"}
MIN_GAP = 0.12                   # s between steps while a key is held (key repeat floods reports)

def decode(report: bytes):
    """report bytes -> 'up' / 'down' / None"""
    if len(report) >= 3 and report[0] == 0x04:
        return ACTIONS.get((report[1], report[2]))
    return None

def nodes():
    found = []
    for h in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            u = open(h + "/device/uevent").read().upper()
        except OSError:
            continue
        if "0000" + "04F2" in u and "00000117" in u:      # HID_ID=0003:000004F2:00000117
            found.append("/dev/" + os.path.basename(h))
    return found

def main():
    fds, last = {}, 0.0
    while True:
        if not fds:
            for n in nodes():
                try:
                    fds[os.open(n, os.O_RDONLY | os.O_NONBLOCK)] = n
                except OSError:
                    pass
            if not fds:
                time.sleep(5)                     # no permission yet / keyboard not there: keep trying
                continue
        r, _, _ = select.select(list(fds), [], [], 5)
        for fd in r:
            try:
                data = os.read(fd, 64)
            except OSError:                       # unplugged / re-enumerated (rgbkb does that on every command): reopen
                for f in fds:
                    try: os.close(f)
                    except OSError: pass
                fds = {}
                break
            action = decode(data)
            if action and time.monotonic() - last >= MIN_GAP:
                last = time.monotonic()
                subprocess.Popen([BRIGHTNESS, action], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--selftest":
        assert decode(bytes.fromhex("047cff")) == "down"
        assert decode(bytes.fromhex("047dff")) == "up"
        assert decode(bytes.fromhex("040000")) is None
        assert decode(bytes.fromhex("0000d7000000")) is None
        print("decode ok")
    else:
        main()
