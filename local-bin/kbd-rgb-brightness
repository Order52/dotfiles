#!/usr/bin/env python3
"""Keyboard backlight brightness for the Acer PH16-71 RGB keyboard (rgbkb).
   kbd-rgb-brightness up | down | toggle | set N       (0-32, step 4)
Bound in Hyprland to SUPER+ALT+F11/F12 (and Up/Down), SUPER+ALT+K for on/off, and the XF86Kbd* keys. Fn+F11/F12 are handled by the keyboard itself. 'toggle' turns the backlight off and back on to the previous effect."""
import json, os, subprocess, sys, time
from pathlib import Path

CFG = Path.home() / ".config/rgbkb/config.json"
PREV = Path.home() / ".cache/rgb-before-off.json"
STEP, LO, HI = 4, 0, 32
RGBKB = str(Path.home() / ".local/bin/rgbkb")

def osd(text, icon="keyboard"):
    subprocess.Popen(["noctalia", "msg", "osd-show", icon, text], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def level_osd(level):
    """Noctalia's own keyboard-backlight OSD (icon + level bar), value in percent."""
    subprocess.Popen(["noctalia", "msg", "keyboard-backlight-osd", str(round(level * 100 / HI))],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def command(effect, p):
    cmd = [RGBKB, effect]
    if p.get("hexcolor"):
        cmd.append(p["hexcolor"])
    if effect != "all":
        cmd += ["--speed", str(p.get("speed", 10)), "--level", str(p.get("level", p.get("brightness", HI)))]
    if effect == "wave":
        cmd += ["--direction", str(p.get("direction", 1))]
    return cmd

def run(cmd):
    env = dict(os.environ, PATH=f"{Path.home()}/.local/bin:" + os.environ.get("PATH", ""))
    subprocess.run(cmd, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

TOKEN = Path("/tmp/kbd-rgb-brightness.token")
APPLY_DELAY = 0.35        # s of silence before the keyboard is actually reprogrammed

def write_level(cfg, level):
    cfg["params"]["level"] = level
    CFG.write_text(json.dumps(cfg))

def apply_later(token):
    """Key repeat sends many steps; every rgbkb command makes the keyboard reconnect on USB, so only the LAST step of a burst is applied."""
    time.sleep(APPLY_DELAY)
    if TOKEN.exists() and TOKEN.read_text() == token and CFG.exists():
        cfg = json.loads(CFG.read_text())
        run(command(cfg["effect"], cfg["params"]))

def main():
    action = sys.argv[1] if len(sys.argv) > 1 else "up"
    if action == "--apply-later":
        return apply_later(sys.argv[2])
    cfg = json.loads(CFG.read_text()) if CFG.exists() else None

    if action == "toggle":
        if cfg and cfg.get("effect") == "all" and cfg["params"].get("hexcolor") == "000000" and PREV.exists():
            prev = json.loads(PREV.read_text())
            run(command(prev["effect"], prev["params"]))
            PREV.unlink(missing_ok=True)
            level_osd(int(prev["params"].get("level", prev["params"].get("brightness", HI))) if prev["effect"] != "all" else HI)
        else:
            if cfg:
                PREV.write_text(json.dumps(cfg))
            run([RGBKB, "all", "000000"])
            level_osd(0)
        return

    if not cfg:
        osd("Keyboard RGB: no saved effect"); return
    effect, p = cfg["effect"], cfg["params"]
    if effect == "all":
        osd("Solid color has no brightness - pick another effect"); return
    level = int(p.get("level", p.get("brightness", HI)))
    if action == "up":
        level = min(HI, level + STEP)
    elif action == "down":
        level = max(LO, level - STEP)
    elif action == "set" and len(sys.argv) > 2:
        level = max(LO, min(HI, int(sys.argv[2])))
    write_level(cfg, level)                 # saved + shown at once (panel / bar read this file)
    level_osd(level)
    token = f"{os.getpid()}-{time.time()}"
    TOKEN.write_text(token)
    subprocess.Popen([sys.executable, __file__, "--apply-later", token], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

main()
