#!/usr/bin/env python3
"""Keyboard backlight brightness for the Acer PH16-71 RGB keyboard (rgbkb).
   kbd-rgb-brightness up | down | toggle | set N       (0-32, step 4)
Bound to XF86KbdBrightnessUp/Down/LightOnOff in Hyprland. 'toggle' turns the backlight off and back on to the previous effect."""
import fcntl, json, os, subprocess, sys
from pathlib import Path

CFG = Path.home() / ".config/rgbkb/config.json"
PREV = Path.home() / ".cache/rgb-before-off.json"
STEP, LO, HI = 4, 0, 32
RGBKB = str(Path.home() / ".local/bin/rgbkb")

def osd(text, icon="keyboard"):
    subprocess.Popen(["noctalia", "msg", "osd-show", icon, text], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def command(effect, p):
    cmd = [RGBKB, effect]
    if p.get("hexcolor"):
        cmd.append(p["hexcolor"])
    if effect != "all":
        cmd += ["--speed", str(p.get("speed", 10)), "--level", str(p.get("level", p.get("brightness", HI)))]
    if effect == "wave":
        cmd += ["--direction", str(p.get("direction", 1))]
    return cmd

def run(cmd):
    env = dict(os.environ, PATH=f"{Path.home()}/.local/bin:" + os.environ.get("PATH", ""))
    subprocess.run(cmd, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def main():
    action = sys.argv[1] if len(sys.argv) > 1 else "up"
    lock = open("/tmp/kbd-rgb-brightness.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)      # key repeat: skip while a previous step is still talking to the keyboard
    except OSError:
        return
    cfg = json.loads(CFG.read_text()) if CFG.exists() else None

    if action == "toggle":
        if cfg and cfg.get("effect") == "all" and cfg["params"].get("hexcolor") == "000000" and PREV.exists():
            prev = json.loads(PREV.read_text())
            run(command(prev["effect"], prev["params"]))
            PREV.unlink(missing_ok=True)
            osd("Keyboard backlight: on")
        else:
            if cfg:
                PREV.write_text(json.dumps(cfg))
            run([RGBKB, "all", "000000"])
            osd("Keyboard backlight: off", "keyboard-off")
        return

    if not cfg:
        osd("Keyboard RGB: no saved effect"); return
    effect, p = cfg["effect"], cfg["params"]
    if effect == "all":
        osd("Solid color has no brightness - pick another effect"); return
    level = int(p.get("level", p.get("brightness", HI)))
    if action == "up":
        level = min(HI, level + STEP)
    elif action == "down":
        level = max(LO, level - STEP)
    elif action == "set" and len(sys.argv) > 2:
        level = max(LO, min(HI, int(sys.argv[2])))
    p["level"] = level
    run(command(effect, p))
    osd(f"Keyboard brightness: {level}/{HI}")

main()
