#!/usr/bin/env python3
"""blue-light-shield — Acer Quick Access' "Blue light shield" for Wayland, done with Noctalia's night light.

  blue-light-shield get                  current level
  blue-light-shield set LEVEL            LEVEL: 0|off  1|low  2|medium  3|high  4|long  (or a colour temperature, e.g. 3600)
  blue-light-shield cycle                off -> low -> medium -> high -> long -> off
  blue-light-shield up | down            one level warmer / cooler

Acer's shield is software only (a colour matrix + gamma LUT, no firmware command) and its exact per-level factors are not recoverable here, so the levels are
colour temperatures: low 4500 K, medium 3800 K, high 3200 K, long hour 2800 K (screen normally 6500 K). It forces Noctalia's night light on at that temperature
(`nightlight.force` + `nightlight.temperature_night`), which Noctalia keeps across restarts. Edit LEVELS below to taste.
"""
import subprocess, sys

LEVELS = [("off", None), ("low", 4500), ("medium", 3800), ("high", 3200), ("long", 2800)]


def noctalia(*args):
    r = subprocess.run(["noctalia", "msg", *args], capture_output=True, text=True)
    if r.returncode != 0:
        print(f"blue-light-shield: noctalia msg {' '.join(args)} failed: {(r.stderr or r.stdout).strip()}", file=sys.stderr)
        sys.exit(1)
    return r.stdout.strip()


def current():
    """(level index, temperature or None). A forced temperature in between two levels reports the nearest one."""
    if noctalia("config-get", "nightlight.force") != "true":
        return 0, None
    temp = int(noctalia("config-get", "nightlight.temperature_night"))
    best = min(range(1, len(LEVELS)), key=lambda i: abs(LEVELS[i][1] - temp))
    return best, temp


def apply(level=None, temp=None):
    if level is not None and level > 0:
        temp = LEVELS[level][1]
    if temp is None:
        noctalia("config-set", "nightlight.force", "false")
        return
    noctalia("config-set", "nightlight.temperature_night", str(temp))
    noctalia("config-set", "nightlight.force", "true")


def parse(v):
    v = v.lower()
    for i, (name, _) in enumerate(LEVELS):
        if v in (name, str(i)):
            return i, None
    if v.isdigit() and 1000 <= int(v) <= 6500:
        return None, int(v)
    print(f"blue-light-shield: unknown level '{v}' (0-4, off low medium high long, or 1000-6500 K)", file=sys.stderr)
    sys.exit(2)


def show():
    i, temp = current()
    print(f"{i} {LEVELS[i][0]}" + (f" ({temp} K)" if temp else ""))


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd = argv[0]
    i, _ = current()
    if cmd == "get":
        pass
    elif cmd == "set" and len(argv) > 1:
        level, temp = parse(argv[1])
        apply(level, temp)
    elif cmd == "cycle":
        apply((i + 1) % len(LEVELS))
    elif cmd == "up":
        apply(min(i + 1, len(LEVELS) - 1))
    elif cmd == "down":
        apply(max(i - 1, 0))
    else:
        print("blue-light-shield: unknown command, see --help", file=sys.stderr)
        sys.exit(2)
    show()


if __name__ == "__main__":
    main(sys.argv[1:])
