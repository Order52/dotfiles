/**
 * Rofi Clipboard Theme - Windows 11 / KDE Style
 * Vertical Stream of Cards
 **/

/*****----- Configuration -----*****/
configuration {
    modi:                       "drun";
    show-icons:                 true;
    display-drun:               "";
    drun-display-format:        "{name}";
}

/*****----- Global Properties -----*****/
@import "shared/colors.rasi"
@import "shared/fonts.rasi"

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    
    /* Windows/KDE Style is usually a narrow, tall list */
    width:                       450px; 
    height:                      75%;
    
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               8px;
    border-color:                @selected;
    background-color:            @background;
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     15px;
    margin:                      0px;
    padding:                     20px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @selected;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     12px 16px;
    border:                      0px solid;
    border-radius:               8px;
    border-color:                @selected;
    background-color:            @background-alt;
    text-color:                  @foreground;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
}
entry {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Paste...";
    placeholder-color:           inherit;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;    /* SINGLE COLUMN (List View) */
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   true; /* Scrollbar often helpful in lists */
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                false;
    fixed-columns:               true;
    
    spacing:                     10px; /* Space between the cards */
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @selected;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

/* Optional Scrollbar styling to match Windows thin look */
scrollbar {
    handle-width:                4px;
    handle-color:                @selected;
    border-radius:               4px;
    background-color:            @background-alt;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     15px;
    
    /* CARD STYLE: Each item is a distinct block */
    border:                      1px solid;
    border-radius:               8px; /* Rounded corners like Win11 */
    border-color:                gray/15%;
    background-color:            white/5%; /* Slight background for the card */
    
    text-color:                  @foreground;
    orientation:                 vertical; /* Stack Image on top of Text */
    cursor:                      pointer;
}

element normal.normal {
    background-color:            white/5%;
    text-color:                  @foreground;
}

element selected.normal {
    /* Highlight the selected card */
    border:                      1px solid;
    border-color:                @selected;
    background-color:            @background-alt;
    text-color:                  @foreground;
}

/* Images span the card width, like Windows 11 */
element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        180px; /* Large preview inside the card */
    cursor:                      inherit;
    margin:                      0px 0px 10px 0px; /* Space below image */
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0; /* Left align text like a list */
}

/*****----- Message -----*****/
error-message {
    padding:                     20px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @selected;
    background-color:            black / 10%;
    text-color:                  @foreground;
}
textbox {
    background-color:            transparent;
    text-color:                  @foreground;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    highlight:                   none;
}
